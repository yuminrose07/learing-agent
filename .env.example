# Learning-Agent 环境变量配置
# 复制为 .env 即可生效
# 优先级：已存在的环境变量 > .env 文件 > 配置文件 > 代码默认值

# Moonshot API Key（必填）
OPENAI_API_KEY=sk-your-moonshot-key-here

# 可选：覆盖模型
LA_MODEL=kimi-2.6

# 可选：覆盖 API 地址
OPENAI_BASE_URL=https://api.moonshot.cn/v1

# 可选：其他参数
# LA_TIMEOUT=60.0
# LA_MAX_RETRIES=3
# LA_DATA_DIR=./learning_agent_data
# LA_OBS_DIR=./observability
# LA_LOG_LEVEL=INFO
