{
  "data_dir": "./learning_agent_data",
  "observability_dir": "./observability",
  "provider": {
    "type": "openai",
    "model": "kimi-2.6",
    "base_url": "https://api.moonshot.cn/v1",
    "timeout": 60.0,
    "max_retries": 3
  },
  "auto_confirm_knowledge": false,
  "log_level": "INFO",
  "tool_guard": {
    "bash_mode": "disabled",
    "bash_allowlist": [],
    "bash_denylist": [],
    "rules": {
      "allow": [],
      "deny": [],
      "ask": []
    }
  },
  "web_search": {
    "enabled": true,
    "provider": "builtin",
    "default_top_k": 5,
    "max_top_k": 10,
    "default_limit_chars": 12000,
    "timeout_seconds": 12,
    "tls_ca_bundle_path": null,
    "prefer_system_trust_store": true,
    "allowed_source_types": [
      "official_docs",
      "official_blog",
      "github_repo",
      "github_issue",
      "community_forum",
      "blog",
      "paper",
      "news",
      "aggregator"
    ]
  }
}
